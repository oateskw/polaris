# Polaris Instagram Management Suite Configuration

# Database
DATABASE_URL=sqlite:///polaris.db

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meta/Instagram API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/callback

# Replicate API (for image generation)
REPLICATE_API_KEY=your_replicate_api_key_here

# GitHub (for media uploads)
GITHUB_REPO=username/repo
GITHUB_BRANCH=main

# Email notifications (lead alerts)
NOTIFICATION_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Yelp API (prospect discovery)
YELP_API_KEY=your_yelp_api_key_here

# Google Places API (prospect discovery fallback — $200/mo free credit)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Sheets (outreach tracking)
GOOGLE_SHEETS_CLIENT_SECRETS_FILE=google_sheets_client_secrets.json
GOOGLE_SHEETS_TOKEN_FILE=google_sheets_token.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: Logging
LOG_LEVEL=INFO
